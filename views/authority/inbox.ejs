<%- include('../partials/head', { title: 'Authority Inbox' }) %>

<div class="layout">
  <%- include('../partials/sidebar', { user, active: 'inbox' }) %>

  <main class="main">

    <div class="page-header">
      <h1>Inbox</h1>
      <p>Issues forwarded to you</p>
    </div>

    <div class="issue-list">

      <% if (issues.length === 0) { %>
        <div class="empty-state">
          <h3>No Pending Issues</h3>
        </div>
      <% } %>

      <% issues.forEach(issue => { %>

        <div class="issue-card compact">

          <!-- LEFT -->
          <div class="issue-left">

            <h3 class="issue-heading">
              <%= issue.title || issue.category %>
            </h3>

            <div class="issue-tags">

              <span class="tag category">
                <%= issue.category %>
              </span>

              <span class="tag status forwarded">
                Forwarded
              </span>

              <span class="tag priority <%= issue.priority.toLowerCase() %>">
                <%= issue.priority %>
              </span>

            </div>

            <div class="issue-meta">

              <strong>By:</strong> <%= issue.studentName %>

              <span class="dot">•</span>

              <%= issue.createdAt.toDateString() %>

            </div>

          </div>


          <!-- ACTION -->
          <div class="issue-actions">

            <a
              href="/authority/issues/<%= issue._id %>"
              class="btn-secondary"
            >
              View Details
            </a>

          </div>

        </div>

      <% }) %>

    </div>

  </main>
</div>

<%- include('../partials/footer') %>